  "decode": {
    "default_span_threshold": 0.5,
    "span_overlap_policy": "none (span architecture default: confidence-first greedy)",
    "count_gate": "entities are [] unless argmax(count_logits) >= 1",
    "char_offsets": "word_char_start[start] .. word_char_end[start+width] (exclusive), then .strip(), offsets reported unstripped"
  },
  "onnx": {
    "file": "model.onnx",
    "opset": 17,
    "dtype": "float32",
    "inputs": {
      "input_ids": {
        "dtype": "int64",
        "shape": [
          "B",
          "S"
        ]
      },
      "attention_mask": {
        "dtype": "int64",
        "shape": [
          "B",
          "S"
        ]
      },
      "text_word_indices": {
        "dtype": "int64",
        "shape": [
          "B",
          "W"
        ]
      },
      "text_word_mask": {
        "dtype": "bool",
        "shape": [
          "B",
          "W"
        ]
      },
      "entity_schema_indices": {
        "dtype": "int64",
        "shape": [
          "B",
          33
        ]
      },
      "class_schema_indices": {
        "dtype": "int64",
        "shape": [
          "B",
          71
        ]
      }
    },
    "outputs": {
      "span_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          32,
          "W",
          8
        ],
        "meaning": "[batch, entity_label_index, word_start, width] raw logits, NOT masked (invalid entries are finite)"
      },
      "span_probs": {
        "dtype": "float32",
        "shape": [
          "B",
          32,
          "W",
          8
        ],
        "meaning": "sigmoid(span_logits) with invalid entries forced to exactly 0.0 (bit-identical to the runtime's -inf mask)"
      },
      "count_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          20
        ],
        "meaning": "predicted-entity-count logits; argmax is the gate"
      },
      "safety_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          2
        ],
        "meaning": "safety logits over ['safe','unsafe']; softmax+argmax"
      },
      "adversarial_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          15
        ],
        "meaning": "adversarial logits over ['jailbreak_persona','jailbreak_hypothetical','jailbreak_roleplay','prompt_injection','indirect_prompt_injection','instruction_override','data_exfiltration','system_prompt_extraction','context_manipulation','token_manipulation','tool_abuse','social_engineering','multi_turn_escalation','schema_poisoning','none']; sigmoid+threshold"
      },
      "harmful_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          30
        ],
        "meaning": "harmful logits over ['harassment','hate_speech','discrimination','doxxing','bullying','violence','dangerous_instructions','weapons','drugs','self_harm','sexual_content','child_exploitation','grooming','sextortion','fraud','scam','social_engineering','impersonation','profanity','extremism','political','war','espionage','cybersecurity','religious','lgbt','misinformation','copyright_violation','pii_exposure','none']; sigmoid+threshold"
      },
      "intent_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          13
        ],
        "meaning": "intent logits over ['informational','instructional','conversational','persuasive','creative','transactional','emotional_support','testing','ambiguous','extractive','adversarial','threatening','solicitation']; softmax+argmax"
      },
      "tone_logits": {
        "dtype": "float32",
        "shape": [
          "B",
          10
        ],
        "meaning": "tone logits over ['neutral','formal','humorous','sarcastic','distressed','confused','pleading','aggressive','manipulative','deceptive']; softmax+argmax"
      },
      "text_states": {
        "dtype": "float32",
        "shape": [
          "B",
          "W",
          "hidden_size"
        ],
        "kind": "diagnostic",
        "meaning": "word-level states fed to the span scorer (first subword per word, zeroed beyond n_words); a port can diff this against its own pipeline to localise an encoder-vs-head mismatch. Not needed for decoding."
      },
      "encoder_hidden": {
        "dtype": "float32",
        "shape": [
          "B",
          "S",
          "hidden_size"
        ],
        "kind": "diagnostic",
        "meaning": "raw DebertaV2 last_hidden_state. Not needed for decoding."
      }
    },
    "num_field_queries": 32
  },
