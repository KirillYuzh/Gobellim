# HTTP
KIT_ADDR=:8080

# Elasticsearch (the only datastore: traces and observations)
KIT_ES_URL=http://localhost:9200

# Weather provider (keyless)
WEATHER_BASE_URL=https://wttr.in

# RBAC policy
KIT_POLICY=demo/policy.yaml

# GigaChat: base64 "clientID:clientSecret" from the Sber cabinet
# https://developers.sber.ru/docs/ru/gigachat/guides/main
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2

# Optional
# GIGACHAT_BASE_URL=https://api.giga.chat
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_CA_FILE=/path/to/root-ca.pem
# KIT_HTTP_TIMEOUT=60s
# KIT_TOKEN_TTL=12h
