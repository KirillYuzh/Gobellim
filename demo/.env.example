# HTTP
KIT_ADDR=:8080

# Elasticsearch: knowledge base, traces and observations
KIT_ES_URL=http://localhost:9200

# Embeddings: any OpenAI-compatible server. The bundled stack runs
# text-embeddings-inference with intfloat/multilingual-e5-small on port 8088.
EMBED_BASE_URL=http://localhost:8088/v1
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384

# Seed the knowledge base on start; documents that already exist are skipped
SEED_KB=true

# Guard L2: the ONNX GLiNER guard, active only in the -tags ort build.
# The directory holds <org>__<name>/ with model.onnx, tokenizer.json and
# config.json; see tools/gliner for how to export it.
KIT_MODELS_DIR=models
GLINER_MODEL=hivetrace__gliner-guard-omni

# Weather provider for the admin-only get_weather tool
WEATHER_BASE_URL=https://wttr.in

# RBAC policy
KIT_POLICY=demo/policy.yaml

# GigaChat: base64 "clientID:clientSecret" from the Sber cabinet
# https://developers.sber.ru/docs/ru/gigachat/guides/main
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2

# Optional
# GIGACHAT_BASE_URL=https://api.giga.chat
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_CA_FILE=/path/to/root-ca.pem
# KIT_HTTP_TIMEOUT=60s
# KIT_TOKEN_TTL=12h
