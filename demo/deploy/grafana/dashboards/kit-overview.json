{
  "uid": "kit-overview",
  "title": "kit overview",
  "tags": ["kit"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM latency p95 (ms)",
      "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
          "query": "kind:GENERATION",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "latency_ms",
              "settings": { "percents": ["95"] }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": { "interval": "1h", "min_doc_count": "1" }
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Errors by kind (guard, authz, provider)",
      "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
          "query": "level:ERROR",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "error_kind",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens by model",
      "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
          "query": "kind:GENERATION",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "sum", "field": "total_tokens" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": { "interval": "1h", "min_doc_count": "1" }
            },
            {
              "id": "3",
              "type": "terms",
              "field": "model",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Guard triggers by rail",
      "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
          "query": "guard_action:reject",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "guard_rail",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top tools",
      "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-observations" },
          "query": "kind:SPAN",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost by tenant",
      "datasource": { "type": "elasticsearch", "uid": "kit-traces" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-traces" },
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "sum", "field": "usage.cost" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": { "interval": "1h", "min_doc_count": "1" }
            },
            {
              "id": "3",
              "type": "terms",
              "field": "tenant",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent traces",
      "datasource": { "type": "elasticsearch", "uid": "kit-traces" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "kit-traces" },
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            { "id": "1", "type": "raw_document", "settings": { "size": "50" } }
          ],
          "bucketAggs": []
        }
      ]
    }
  ]
}
